cartStripe = PAGE
cartStripe {
    typeNum = {$plugin.tx_cartstripe.redirectTypeNum}

    config {
        disableAllHeaderCode = 1
        xhtml_cleaning = 0
        admPanel = 0
        debug = 0
        no_cache = 1
    }

    10 = EXTBASEPLUGIN
    10 {
        extensionName = CartStripe
        pluginName = Cart
    }
}

plugin.tx_cartstripe {
    sandbox = {$plugin.tx_cartstripe.sandbox}
    redirectTypeNum = {$plugin.tx_cartstripe.redirectTypeNum}
    sendEachItemToStripe = {$plugin.tx_cartstripe.sendEachItemToStripe}
}
