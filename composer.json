{
    "name": "schnitzler/cart-stripe",
    "description": "Shopping Cart(s) for TYPO3 - Stripe Payment Provider",
    "license": [
        "GPL-2.0+"
    ],
    "type": "typo3-cms-extension",
    "keywords": [
        "TYPO3 CMS",
        "Shopping Cart",
        "stripe",
        "cart"
    ],
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-curl": "*",
        "extcode/cart": "^12",
        "stripe/stripe-php": "^15",
        "typo3/cms-core": "~14.3.0",
        "typo3/cms-extbase": "~14.3.0",
        "typo3/cms-frontend": "~14.3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Schnitzler\\CartStripe\\": "Classes"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": false
        },
        "platform": {
            "php": "8.2.99"
        },
        "sort-packages": true
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "cart_stripe",
            "version": "14.3.0",
            "Package": {
                "providesPackages": []
            }
        }
    }
}
