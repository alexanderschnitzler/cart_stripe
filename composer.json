{
    "name": "schnitzler/cart-stripe",
    "description": "Shopping Cart(s) for TYPO3 - Stripe Payment Provider",
    "license": [
        "GPL-2.0+"
    ],
    "type": "typo3-cms-extension",
    "keywords": [
        "TYPO3 CMS",
        "Shopping Cart",
        "stripe",
        "cart"
    ],
    "require": {
        "ext-curl": "*",
        "extcode/cart": "^11.0 || dev-main",
        "stripe/stripe-php": "^15",
        "typo3/cms-core": "~13.4.0 || ~14.3.0",
        "typo3/cms-extbase": "~13.4.0 || ~14.3.0",
        "typo3/cms-frontend": "~13.4.0 || ~14.3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Schnitzler\\CartStripe\\": "Classes"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.99"
        },
        "sort-packages": true
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "cart_stripe"
        }
    }
}
